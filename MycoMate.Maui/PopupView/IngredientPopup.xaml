<?xml version="1.0" encoding="utf-8"?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
               xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
               x:Class="MycoMate.Maui.PopupView.IngredientPopup"
               CanBeDismissedByTappingOutsideOfPopup="False"
               HorizontalOptions="Center"
               VerticalOptions="Center">

    <Border StrokeShape="RoundRectangle 16"
            BackgroundColor="White"
            Padding="24"
            WidthRequest="320">
        <VerticalStackLayout Spacing="16">

            <Label x:Name="TitleLabel"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#212121" />

            <!-- Ingredient picker (Add mode) -->
            <core:SfTextInputLayout x:Name="PickerLayout"
                                     Hint="Ingredient"
                                     ContainerType="Outlined">
                <Picker x:Name="IngredientPicker"
                        ItemDisplayBinding="{Binding DisplayName}" />
            </core:SfTextInputLayout>

            <!-- Ingredient name (Edit mode) -->
            <core:SfTextInputLayout x:Name="IngredientNameLayout"
                                     Hint="Ingredient"
                                     ContainerType="Outlined"
                                     IsEnabled="False">
                <Entry x:Name="IngredientNameEntry" IsEnabled="False" />
            </core:SfTextInputLayout>

            <!-- Dry percent -->
            <core:SfTextInputLayout Hint="Dry matter % of recipe"
                                     ContainerType="Outlined">
                <Entry x:Name="DryPercentEntry"
                       Keyboard="Numeric"
                       ReturnType="Done" />
            </core:SfTextInputLayout>

            <!-- Action buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <buttons:SfButton Grid.Column="0"
                                  Text="Cancel"
                                  BackgroundColor="#E0E0E0"
                                  TextColor="#424242"
                                  CornerRadius="8"
                                  Clicked="OnCancelClicked" />
                <buttons:SfButton Grid.Column="1"
                                  Text="Save"
                                  BackgroundColor="#2196F3"
                                  TextColor="White"
                                  CornerRadius="8"
                                  Clicked="OnSaveClicked" />
            </Grid>

            <!-- Delete button (Edit mode only) -->
            <buttons:SfButton x:Name="DeleteButton"
                              Text="Remove Ingredient"
                              BackgroundColor="Transparent"
                              TextColor="#F44336"
                              CornerRadius="8"
                              IsVisible="False"
                              Clicked="OnDeleteClicked" />

        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
