<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
             xmlns:projects="clr-namespace:MycoMate.Maui.Views.Projects"
             x:Class="MycoMate.Maui.MainPage">

    <Grid
        Padding="00,0"
        VerticalOptions="Fill">

        <Label
            HorizontalOptions="Center"
            Text="Welcome to Myco Mate"
            TextColor="Blue"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1" />

        <tabView:SfTabView
            x:Name="TabViewMain"
            EnableSwiping="False"
            VerticalOptions="Fill"
            TabBarPlacement="Bottom"
            TabWidthMode="SizeToContent"
            TabBarBackground="#CC000000"
            IndicatorBackground="#4CAF50">
            <tabView:SfTabView.Items>
                <tabView:SfTabItem
                    Header="Projects"
                    TextColor="White">
                    <projects:ProjectsView x:Name="ProjectsView" />
                </tabView:SfTabItem>

                <tabView:SfTabItem
                    Header="Formulas"
                    TextColor="White">
                    <Grid
                        BackgroundColor="Orange"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill" />
                </tabView:SfTabItem>
            </tabView:SfTabView.Items>
        </tabView:SfTabView>

    </Grid>

</ContentPage>